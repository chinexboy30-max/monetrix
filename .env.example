# MONETRIX INVEST environment variables example
# Copy this file to .env and set values before starting the server.

# Server
PORT=3000
NODE_ENV=development
# Optional comma-separated frontend origins when the UI is hosted separately.
CORS_ORIGIN=

# Secrets
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
ADMIN_TOKEN=replace_with_a_unique_random_admin_token_at_least_32_characters

# Existing bank-account verification settings. Use "live" in production to prevent mock verifications.
PAYMENT_MODE=testing
APP_TIMEZONE=Africa/Lagos
# Paystack hosted checkout (use test keys for local/staging work)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/deposit.html
# Paystack signs webhooks with the API secret key. Leave blank to use PAYSTACK_SECRET_KEY;
# if set, this must match the key configured in Paystack.
PAYSTACK_WEBHOOK_SECRET=
# Set true only after Paystack has approved the live collection model for this business.
PAYSTACK_COLLECTION_APPROVED=false
PAYSTACK_PREFERRED_BANK=wema-bank
# Legacy provider settings for configured bank-account verification.
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=

# Optional overrides for displayed funding account (also stored in data/store.json defaults):
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Notes:
# - Never commit real secrets into source control. Use a secure secrets manager or environment variables on the host.
# - Use unique random values for JWT_SECRET and ADMIN_TOKEN. Example (Linux/macOS):
#     head -c32 /dev/urandom | base64
# - On Windows PowerShell (temporary env while starting):
#     $env:ADMIN_TOKEN='your-token'; $env:JWT_SECRET='your-secret'; node server.js
